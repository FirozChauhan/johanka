# Copy to .env (optional). These override the /settings page values.
# Get them from https://streamtape.com -> Account:
#   STREAMTAPE_LOGIN = your "API/FTP Username"   (sent as the API `login` param)
#   STREAMTAPE_KEY   = your "API/FTP Password"   (sent as the API `key` param)

STREAMTAPE_LOGIN=
STREAMTAPE_KEY=

# Cloudinary (optional) — hosted poster thumbnails. Get them from
# https://cloudinary.com/console -> Dashboard (Cloud name) and API Keys:
#   CLOUDINARY_CLOUD_NAME = cloud name / cloud id
#   CLOUDINARY_API_KEY    = API Key
#   CLOUDINARY_API_SECRET = API Secret

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PostgreSQL (optional) — persistent settings + catalog enrichment (posters,
# descriptions, durations) keyed by StreamTape file id. The /settings values
# (StreamTape/Cloudinary credentials) are stored here so they survive across
# browsers and incognito windows. Example:
#   postgres://user:password@host:5432/dbname
# Tables are created automatically on first use. Set this in env so every
# browser (including a fresh incognito window) can reach the stored settings.

DATABASE_URL=

# Admin key — the long random passphrase that unlocks /settings (view + edit).
# Recommended: `openssl rand -hex 32`. If set, it ALWAYS wins (even over a key
# saved to the database) and locks the settings from first boot. Leave blank to
# create the key from /settings on first run instead.

JOHANKA_ADMIN_KEY=

# Optional
# NEXT_TELEMETRY_DISABLED=1
